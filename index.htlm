            }
        ];

        let products = JSON.parse(localStorage.getItem('espacio_natural_products')) || defaultProducts;
        let siteSettings = JSON.parse(localStorage.getItem('espacio_natural_settings')) || { logoUrl: '', pin: '1234' };
        let currentCategory = 'Todos';
        let searchQuery = '';

        window.onload = function() {
            renderProducts();
            applySiteSettings();
        };

        function applySiteSettings() {
            if (siteSettings.logoUrl) {
                document.getElementById('headerLogoImg').src = siteSettings.logoUrl;
                document.getElementById('footerLogoImg').src = siteSettings.logoUrl;
                document.getElementById('adminLogoUrl').value = siteSettings.logoUrl;
            }
            if (!siteSettings.pin) {
                siteSettings.pin = '1234';
            }
        }

        function handleLogoUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    siteSettings.logoUrl = e.target.result;
                    document.getElementById('adminLogoUrl').value = e.target.result;
                    applySiteSettings();
                    localStorage.setItem('espacio_natural_settings', JSON.stringify(siteSettings));
                };
                reader.readAsDataURL(file);
            }
        }

        function saveSiteSettings() {
            siteSettings.logoUrl = document.getElementById('adminLogoUrl').value;
            const newPin = document.getElementById('adminNewPin').value.trim();
            if (newPin) {
                siteSettings.pin = newPin;
                document.getElementById('adminNewPin').value = '';
                alert('¡Configuración y nuevo PIN de administrador guardados exitosamente!');
            } else {
                alert('¡Logotipo guardado exitosamente!');
            }
            localStorage.setItem('espacio_natural_settings', JSON.stringify(siteSettings));
            applySiteSettings();
        }

        function openAdminLoginModal() {
            document.getElementById('adminPinInput').value = '';
            document.getElementById('loginErrorMsg').classList.add('hidden');
            document.getElementById('adminLoginModal').classList.remove('hidden');
        }

        function closeAdminLoginModal() {
            document.getElementById('adminLoginModal').classList.add('hidden');
        }

        function verifyAdminPin() {
            const enteredPin = document.getElementById('adminPinInput').value.trim();
            const correctPin = siteSettings.pin || '1234';

            if (enteredPin === correctPin) {
                closeAdminLoginModal();
                openAdminModal();
            } else {
                document.getElementById('loginErrorMsg').classList.remove('hidden');
            }
        }

        function renderProducts() {
            const grid = document.getElementById('productGrid');
            const noProducts = document.getElementById('noProducts');
            grid.innerHTML = '';

            const filtered = products.filter(p => {
                const matchCat = currentCategory === 'Todos' || p.category === currentCategory;
                const matchSearch = p.name.toLowerCase().includes(searchQuery.toLowerCase()) || 
                                    p.desc.toLowerCase().includes(searchQuery.toLowerCase());
                return matchCat && matchSearch;
            });

            if (filtered.length === 0) {
                noProducts.classList.remove('hidden');
                return;
            } else {
                noProducts.classList.add('hidden');
            }

            filtered.forEach(p => {
                const card = document.createElement('div');
                card.className = 'bg-white rounded-3xl p-6 shadow-sm border border-forest/10 flex flex-col justify-between hover:shadow-md transition';
                
                const waMessage = encodeURIComponent(`Hola, me interesa pedir por WhatsApp el producto: *${p.name}* ($${p.price} MXN). ¿Hay disponibilidad?`);
                const waLink = `https://wa.me/529621058115?text=${waMessage}`;

                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start mb-4">
                            <div class="w-12 h-12 bg-forest-sage text-forest rounded-2xl flex items-center justify-center text-xl shadow-inner">
                                <i class="fa-solid ${p.icon || 'fa-leaf'}"></i>
                            </div>
                            <span class="bg-forest/10 text-forest text-[11px] font-bold px-3 py-1 rounded-full">${p.category}</span>
                        </div>
                        <h3 class="font-serif font-bold text-lg text-forest mb-2">${p.name}</h3>
                        <p class="text-gray-600 text-xs sm:text-sm leading-relaxed mb-4">${p.desc}</p>
                    </div>
                    <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
                        <span class="font-serif font-bold text-xl text-forest">$${p.price} <span class="text-xs font-sans text-gray-500 font-normal">MXN</span></span>
                        <a href="${waLink}" target="_blank" class="bg-forest hover:bg-forest-light text-white font-bold px-4 py-2.5 rounded-xl text-xs uppercase tracking-wider transition shadow flex items-center gap-2">
                            <i class="fa-brands fa-whatsapp text-sm"></i> Pedir por WA
                        </a>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function setCategory(cat) {
            currentCategory = cat;
            document.querySelectorAll('.category-btn').forEach(btn => {
                if (btn.textContent.trim().toLowerCase() === cat.toLowerCase()) {
                    btn.className = 'category-btn active px-4 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider bg-forest text-white transition-all shadow-sm';
                } else {
                    btn.className = 'category-btn px-4 py-2 rounded-xl text-xs font-semibold uppercase tracking-wider bg-forest-sage/50 text-forest hover:bg-forest hover:text-white transition-all';
                }
            });
            renderProducts();
        }

        function filterProducts() {
            searchQuery = document.getElementById('searchInput').value;
            renderProducts();
        }

        function openAdminModal() {
            document.getElementById('adminModal').classList.remove('hidden');
            renderAdminProductList();
        }

        function closeAdminModal() {
            document.getElementById('adminModal').classList.add('hidden');
            resetProductForm();
        }

        function renderAdminProductList() {
            const list = document.getElementById('adminProductList');
            list.innerHTML = '';

            products.forEach(p => {
                const item = document.createElement('div');
                item.className = 'flex items-center justify-between bg-white p-3 rounded-xl border border-gray-200 text-xs';
                item.innerHTML = `
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 bg-forest-sage text-forest rounded-lg flex items-center justify-center">
                            <i class="fa-solid ${p.icon || 'fa-leaf'}"></i>
                        </div>
                        <div>
                            <span class="font-bold text-gray-800 block">${p.name}</span>
                            <span class="text-gray-500">$${p.price} MXN • ${p.category}</span>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="editProduct(${p.id})" class="bg-blue-50 hover:bg-blue-100 text-blue-600 px-3 py-1.5 rounded-lg font-medium transition">Editar</button>
                        <button onclick="deleteProduct(${p.id})" class="bg-red-50 hover:bg-red-100 text-red-600 px-3 py-1.5 rounded-lg font-medium transition">Eliminar</button>
                    </div>
                `;
                list.appendChild(item);
            });
        }

        function saveProduct() {
            const id = document.getElementById('editProductId').value;
            const name = document.getElementById('prodName').value.trim();
            const category = document.getElementById('prodCategory').value;
            const price = parseFloat(document.getElementById('prodPrice').value);
            const desc = document.getElementById('prodDesc').value.trim();
            const icon = document.getElementById('prodIcon').value.trim() || 'fa-leaf';

            if (!name || isNaN(price) || !desc) {
                alert('Por favor completa todos los campos obligatorios.');
                return;
            }

            if (id) {
                products = products.map(p => p.id == id ? { id: Number(id), name, category, price, desc, icon } : p);
            } else {
                const newId = products.length > 0 ? Math.max(...products.map(p => p.id)) + 1 : 1;
                products.push({ id: newId, name, category, price, desc, icon });
            }

            localStorage.setItem('espacio_natural_products', JSON.stringify(products));
            renderProducts();
            renderAdminProductList();
            resetProductForm();
            alert('¡Producto guardado exitosamente!');
        }

        function editProduct(id) {
            const p = products.find(prod => prod.id === id);
            if (!p) return;

            document.getElementById('editProductId').value = p.id;
            document.getElementById('prodName').value = p.name;
            document.getElementById('prodCategory').value = p.category;
            document.getElementById('prodPrice').value = p.price;
            document.getElementById('prodDesc').value = p.desc;
            document.getElementById('prodIcon').value = p.icon;

            document.getElementById('formTitle').innerHTML = '<i class="fa-solid fa-pen-to-square"></i> Editar Producto';
            document.getElementById('cancelEditBtn').classList.remove('hidden');
        }

        function deleteProduct(id) {
            if (confirm('¿Estás seguro de eliminar este producto?')) {
                products = products.filter(p => p.id !== id);
                localStorage.setItem('espacio_natural_products', JSON.stringify(products));
                renderProducts();
                renderAdminProductList();
            }
        }

        function resetProductForm() {
            document.getElementById('editProductId').value = '';
            document.getElementById('prodName').value = '';
            document.getElementById('prodPrice').value = '';
            document.getElementById('prodDesc').value = '';
            document.getElementById('prodIcon').value = 'fa-leaf';
            document.getElementById('formTitle').innerHTML = '<i class="fa-solid fa-plus-circle"></i> Agregar Nuevo Producto';
            document.getElementById('cancelEditBtn').classList.add('hidden');
        }
    </script>
</body>
</html>
